# Required: your Google Gemini API key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional but recommended: Groq takes over when Gemini is rate-limited, overloaded or out of quota
# (free key at https://console.groq.com/keys). Leave empty to disable the fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Gemini models
CHAT_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is out of quota, overloaded or retired
BACKUP_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# minimal | low | medium | high, or empty for the model default (more thinking = slower first word)
CHAT_THINKING=minimal
# Transcribes voice questions using the crawled site's names and terms
STT_MODEL=gemini-3.5-flash-lite
# Seconds to wait for Gemini to start answering before retrying or falling back to Groq
CHAT_TIMEOUT=15
# Seconds per model for voice transcription before trying the next model
STT_TIMEOUT=8

# Local models (ONNX via FastEmbed, run on CPU, downloaded once into MODEL_CACHE_DIR)
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Empty disables reranking (then RELEVANCE_THRESHOLD is used instead of RERANK_THRESHOLD)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=model_cache

# Retrieval
TOP_K=6
RETRIEVE_CANDIDATES=12
RERANK_THRESHOLD=-10
RELEVANCE_THRESHOLD=0.60
ANSWER_CACHE_SIZE=100

# Crawler
CRAWL_CONCURRENCY=8
DEFAULT_MAX_PAGES=200
MAX_PAGES_LIMIT=500
REQUEST_TIMEOUT=15
USE_PLAYWRIGHT=true
USER_AGENT=SiteSenseBot/1.0 (+website-to-chatbot crawler)

# Multi-user limits (each visitor gets their own chatbot)
MAX_CONCURRENT_CRAWLS=2
MAX_ACTIVE_SITES=20
SITE_TTL_MINUTES=60
# Per client IP; 0 disables a limit
CRAWLS_PER_HOUR=10
QUESTIONS_PER_MINUTE=15
VOICE_PER_MINUTE=12
TTS_PER_MINUTE=20
# true only behind a reverse proxy (Hugging Face Spaces, Render, Nginx…)
TRUST_PROXY_HEADERS=false

# Storage and voice
CHROMA_DIR=chroma_data
TTS_VOICE=en-US-AriaNeural
